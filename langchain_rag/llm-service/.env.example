# Base URL of the Ollama node this service calls.
OLLAMA_BASE_URL=http://localhost:11434

# Must match the model baked into the ollama/ image (see ollama/README.md).
OLLAMA_MODEL=qwen2.5:7b-instruct

# RAG retrieval (app/retrieval.py) — S3 Vectors (infra/terraform/modules/ai_data).
# Leave VECTOR_BUCKET_NAME unset to run without RAG (chain.py falls back to
# ungrounded replies, same as before this was implemented).

# Embedding model for retrieval; must be pulled into the ollama/ image
# (OLLAMA_EMBED_MODEL build arg) and match infra/terraform/modules/ai_data's
# vector_dimension (768 for nomic-embed-text).
OLLAMA_EMBED_MODEL=nomic-embed-text

# S3 Vectors bucket/index names — defaults match
# infra/terraform/modules/ai_data's variable defaults for this project/env;
# double-check with `terraform output` if they ever diverge.
VECTOR_BUCKET_NAME=team04-dev-vector-bucket
VECTOR_INDEX_NAME=team04-chatbot-vector-index

# Region the S3 Vectors bucket/index live in.
AWS_REGION=us-east-1

# Locally, boto3 needs your own AWS credentials on the environment (e.g.
# `source /mnt/d/Desktop/AWS/aws-mfa.sh <profile> <otp>` before running this
# service) — nothing here supplies them. In-cluster, EKS Pod Identity
# supplies them automatically (see gitops/langchain/base/serviceaccount-llm-service.yaml).
