# llm-service가 호출할 Ollama 주소.
OLLAMA_BASE_URL=http://localhost:11434

# ../ollama 이미지에 미리 받아 둔 모델과 같아야 합니다(ollama/README.md 참고).
OLLAMA_MODEL=qwen2.5:7b-instruct

# RAG 검색용 임베딩 모델. ../ollama 이미지에 함께 받아 둔 모델이어야 하고,
# S3 Vectors 인덱스의 차원(nomic-embed-text = 768)과 맞아야 합니다.
OLLAMA_EMBED_MODEL=nomic-embed-text

# RAG 검색(app/retrieval.py) — S3 Vectors 버킷/인덱스.
# VECTOR_BUCKET_NAME을 비우면 RAG 없이(근거 없는 답변으로) 동작합니다.
VECTOR_BUCKET_NAME=team04-dev-vector-bucket
VECTOR_INDEX_NAME=team04-chatbot-vector-index

# S3 Vectors 버킷/인덱스가 있는 리전.
AWS_REGION=us-east-1

# 검색해서 context로 붙일 문서 수.
RAG_TOP_K=3

# 의도 분류(app/intent.py)에 넣을 최근 대화 이력 메시지 수.
INTENT_HISTORY_MESSAGES=10

# boto3는 환경변수(AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN) 등 표준 방식으로
# 자격 증명을 찾습니다. 비밀값이므로 이 파일에 적지 말고 셸 환경변수로 넘기세요.
