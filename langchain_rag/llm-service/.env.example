# ── LLM / 임베딩 공급자 ─────────────────────────────────────
# ollama: 로컬 docker compose 기본(../ollama 이미지) / vertex: GCP Vertex AI (dev·prod)
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
# ../ollama 이미지에 미리 받아 둔 모델과 같아야 합니다(ollama/README.md 참고).
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vertex AI (LLM_PROVIDER=vertex)
GCP_PROJECT_ID=likelion-devops-7th-3rd-team4
# 임베딩 리전 / 채팅 리전. Gemini는 서울 리전에서 429(용량 부족)가 잦아 global 엔드포인트를 씁니다.
GCP_LOCATION=asia-northeast3
VERTEX_CHAT_LOCATION=global
VERTEX_CHAT_MODEL=gemini-2.5-flash
# 768차원 — S3 Vectors 인덱스 차원과 같습니다. 임베딩 모델을 바꾸면 scripts.ingest를 다시 실행하세요.
VERTEX_EMBED_MODEL=text-multilingual-embedding-002
# 서비스 계정 키 JSON 문자열. 비우면 ADC(gcloud auth application-default login)를 씁니다.
# 비밀값이므로 이 파일에 적지 말고, 클러스터에서는 backend-secrets(Ansible)로 주입합니다.
# GCP_SA_KEY_JSON=

# ── RAG 벡터 스토어 ─────────────────────────────────────────
# s3vectors: AWS S3 Vectors (prod) / object: S3 호환 저장소(MinIO)의 JSON (dev) / none: RAG 없음
VECTOR_STORE=s3vectors
# 검색해서 context로 붙일 문서 수.
RAG_TOP_K=3
# 이 코사인 유사도 미만인 문서는 버립니다. 임베딩 모델을 바꾸면 python -m scripts.eval_retrieval 로 다시 정하세요.
RAG_MIN_SCORE=0.62

# VECTOR_STORE=s3vectors — VECTOR_BUCKET_NAME을 비우면 RAG 없이(근거 없는 답변으로) 동작합니다.
VECTOR_BUCKET_NAME=team04-dev-vector-bucket
VECTOR_INDEX_NAME=team04-chatbot-vector-index
AWS_REGION=us-east-1
# boto3는 환경변수(AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN) 등 표준 방식으로
# 자격 증명을 찾습니다. 비밀값이므로 이 파일에 적지 말고 셸 환경변수로 넘기세요.

# VECTOR_STORE=object — 온프레미스 MinIO(DB 노드)의 rag-index 버킷
# VECTOR_OBJECT_ENDPOINT=http://<DB 노드 Tailscale IP>:9000
# VECTOR_OBJECT_BUCKET=rag-index
# VECTOR_OBJECT_KEY=rag/index.json
# VECTOR_OBJECT_REGION=ap-northeast-2
# VECTOR_OBJECT_ACCESS_KEY=
# VECTOR_OBJECT_SECRET_KEY=
# 인덱스 파일이 바뀌었는지(ETag) 확인하는 주기(초)
# VECTOR_OBJECT_REFRESH_SECONDS=300

# ── 의도 분류 ───────────────────────────────────────────────
# 의도 분류(app/intent.py)에 넣을 최근 대화 이력 메시지 수.
INTENT_HISTORY_MESSAGES=10

# ── 타임아웃 ────────────────────────────────────────────────
# 바깥(n8n · chat-bot-service 50초)보다 먼저 끊기도록 맞춘 값입니다(../n8n/README.md 타임아웃 절).
# LLM·임베딩 호출 1회 타임아웃(초)과 429·5xx·타임아웃 시 재시도 횟수(지수 백오프)
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
# POST /chat 한 턴 전체 마감(초). 넘으면 504. CPU 전용 로컬 Ollama는 늘려야 할 수 있습니다.
CHAT_REQUEST_TIMEOUT_SECONDS=40
