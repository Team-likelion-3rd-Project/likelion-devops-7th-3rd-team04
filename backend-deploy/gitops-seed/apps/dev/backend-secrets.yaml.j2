# 온프레미스 dev 클러스터의 backend-secrets Application — root app(dev-apps, Ansible roles/argocd)이 이 파일로 만듭니다.
#   차트  : {{ gitlab_app_project_path }} 의 backend-deploy/charts/backend-secrets (GitHub 모노레포 미러)
#   values: 이 레포의 envs/dev/backend-secrets.yaml (Secret key ← OpenBao 경로 · 속성 매핑)
#
# 만드는 것: ExternalSecret backend-secrets · seed-admin → ESO 가 OpenBao(team04-hotel/dev/*) 값으로 Secret 을 만듦.
# 값은 OpenBao 에만 있고 이 레포에는 이름만 있습니다 (infra/ansible README 16절).
#
# sources[0].targetRevision 은 차트 커밋 SHA(40자)로 고정해 두세요 — 모노레포에 차트 변경이 push 되는 것만으로 Secret 구성이 바뀌지 않게.
# seed 는 커밋을 알 수 없어 develop 으로 시작합니다. 차트를 고쳤을 때만 이 값을 MR 로 갱신합니다 (CI deploy-dev 는 이 파일을 건드리지 않음).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: backend-secrets
  namespace: argocd
  # finalizer 를 두지 않음 — 이 파일이나 Application 을 지워도 ExternalSecret · Secret 은 남습니다
  # (ExternalSecret 은 creationPolicy: Owner 라, 지우면 Secret 도 함께 지워져 backend 전체가 env 를 잃음)
spec:
  project: backend
  sources:
    - repoURL: https://{{ gitlab_fqdn }}/{{ gitlab_app_project_path }}.git
      path: backend-deploy/charts/backend-secrets
      targetRevision: develop
      helm:
        releaseName: backend-secrets
        valueFiles:
          - $values/envs/dev/backend-secrets.yaml
    - repoURL: https://{{ gitlab_fqdn }}/{{ gitlab_gitops_project_path }}.git
      targetRevision: {{ gitlab_default_branch }}
      ref: values
  destination:
    server: https://kubernetes.default.svc
    namespace: backend
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      # 네임스페이스는 Ansible(k8s-cicd.yml)이 만듦
      - CreateNamespace=false
    retry:
      limit: 3
      backoff:
        duration: 30s
        factor: 2
        maxDuration: 5m
