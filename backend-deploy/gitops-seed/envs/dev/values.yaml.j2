# 온프레미스 dev 클러스터 (ArgoCD backend 앱 — apps/dev/backend.yaml, namespace: backend)
# 차트: GitHub 모노레포 backend-deploy/charts/backend (기본값은 그 values.yaml)
#
# global.imageTag 는 CI deploy-dev job 이 커밋 SHA 로 갱신하고 커밋합니다 — 직접 고치지 마세요.
# main 에 커밋하면 ArgoCD 가 최대 3분 안에 클러스터에 반영합니다 (main 커밋 = 배포).
# 배포 일정에 맞춰 반영할 변경은 브랜치 · MR 로 준비해 두고 배포 시점에 merge 하세요.
global:
  imageRegistry: {{ gitlab_fqdn }}:{{ gitlab_registry_port }}
  imageRepositoryPrefix: {{ gitlab_app_project_path }}/
  imageTag: ""

# Traefik(NodePort 30080) — 개발자 PC 의 Vite proxy 가 http://<control-plane>.<tailnet>.ts.net:30080 으로 연결
ingress:
  enabled: true
  className: traefik
  host: ""
  paths:
    - /api
    - /api-docs   # dev 전용 Swagger

# Prometheus 메트릭 — 서비스마다 METRICS_PORT(9464) + PodMonitor. dev Prometheus 는 infra/ansible monitoring.yml (README 17절)
metrics:
  enabled: true

# 결제 서비스 · 결제 DB · ElasticMQ(SQS 대체)는 클러스터 밖 결제 노드(infra/ansible payment.yml)에서 운영합니다.
# 결제 노드 Tailscale IP 는 payment.yml 실행 결과 마지막에 이 파일에 넣을 값과 함께 출력됩니다 — 아래 주석의 <payment ts ip> 를 채우세요.
services:
  api-gateway:
    env:
      CORS_ORIGIN: http://localhost:5173
      # PAYMENT_SERVICE_HOST: "<payment ts ip>:3004"
  booking-service:
    # 결제 노드의 payment-service 가 gRPC 로 호출 (<control plane Tailscale IP>:30303)
    nodePort: 30303
    # env:
    #   PAYMENT_SERVICE_HOST: "<payment ts ip>:3004"
    #   SQS_ENDPOINT: "http://<payment ts ip>:9324"
    #   SQS_REGION: ap-northeast-2
    #   PAYMENT_RESULT_QUEUE_URL: "http://<payment ts ip>:9324/000000000000/payment-result.fifo"
    #   AWS_ACCESS_KEY_ID: elasticmq        # ElasticMQ 용 더미 (검증 안 함)
    #   AWS_SECRET_ACCESS_KEY: elasticmq
  # 카카오 로그인 — 앱 키는 OpenBao kakao-login → ESO 가 backend-secrets 에 넣음 (infra/ansible README 16절)
  auth-service:
    env:
      # 카카오 로그인 후 돌아올 프론트 주소 (쉼표로 여러 개). 카카오 콘솔 Redirect URI 와 문자열까지 같아야 함
      KAKAO_REDIRECT_URIS: "http://localhost:5174/auth/kakao/callback,http://localhost:5175/auth/kakao/callback"
    # 리스트는 차트 기본값을 덮어쓰므로 기본값 8개도 다시 적음
    secretEnv: [DB_HOST, DB_USERNAME, DB_PASSWORD, DB_DATABASE, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, REDIS_HOST, REDIS_PASSWORD, KAKAO_CLIENT_ID, KAKAO_CLIENT_SECRET]
  # 객실 이미지는 DB 노드 MinIO 의 room-images 버킷 (infra/ansible README 7-6). 주소 · 앱 키는 OpenBao minio-app → ESO 가 backend-secrets 에 넣음
  hotel-service:
    env:
      S3_REGION: ap-northeast-2   # MinIO 에서는 의미 없지만 SDK 서명에 필요해 고정
      S3_BUCKET: room-images
      S3_FORCE_PATH_STYLE: "true"
      # 사진 보기 = 서명 없는 고정 URL <IMAGE_BASE_URL>/<objectKey> (운영 CloudFront 와 같은 방식, infra/ansible README 7-6).
      # MinIO room-types/* 익명 읽기 정책(db.yml)을 적용한 뒤 주석을 풀고 <DB ts ip> 를 채우세요 — db.yml 마지막 출력에 값이 나옴.
      # 비워 두면 예전처럼 Presigned GET URL(1시간 만료)
      # IMAGE_BASE_URL: "http://<DB ts ip>:9000/room-images"
    # 리스트는 차트 기본값을 덮어쓰므로 DB_* · REDIS_*(조회 캐시, DB 노드 Valkey) 도 다시 적음
    secretEnv: [DB_HOST, DB_USERNAME, DB_PASSWORD, DB_DATABASE, REDIS_HOST, REDIS_PASSWORD, S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY]
  pg-mock-service:
    # 결제 노드의 payment-service 가 HTTP 로 호출 (<control plane Tailscale IP>:30307)
    nodePort: 30307
  # 결제 노드에서 운영 — 클러스터에는 배포하지 않음
  payment-service:
    enabled: false
  # 대화 이력은 DB 노드의 DynamoDB Local (db.yml). 주소는 OpenBao dynamodb → ESO 가 backend-secrets 에 넣음
  chat-bot-service:
    secretEnv: [DYNAMODB_ENDPOINT]
  # 챗봇 AI: Vertex AI(GCP 서비스 계정 키) + RAG 인덱스는 DB 노드 MinIO 의 rag-index 버킷 (infra/ansible README 15절)
  # 인덱스는 아래 llmIngest Job 이 배포 때마다 적재 (수동: kubectl -n backend exec deploy/llm-service -- python -m scripts.ingest)
  llm-service:
    enabled: true
    env:
      VECTOR_STORE: object
      VECTOR_OBJECT_BUCKET: rag-index
    secretEnv:
      - GCP_SA_KEY_JSON
      - VECTOR_OBJECT_ENDPOINT
      - VECTOR_OBJECT_ACCESS_KEY
      - VECTOR_OBJECT_SECRET_KEY

n8n:
  enabled: true

# RAG 문서 적재 Job (차트 templates/llm-ingest-job.yaml) — 운영처럼 llm-service 이미지가 바뀔 때마다 corpus 를 다시
# 적재하고 corpus 에서 지운 문서는 인덱스에서 뺀다. env · Secret 은 위 llm-service 값(MinIO rag-index)을 그대로 씀
llmIngest:
  enabled: true

# 결제 DB 마이그레이션(Flyway)은 결제 노드가 payment-service 갱신 직전에 실행 — 결제 DB 를 클러스터에 노출하지 않음
migrations:
  # 이전 버전으로 롤백하면(DB 가 이미지보다 앞섬) 메인 DB 를 비우고 그 버전까지 다시 적용 → 아래 seed 가 데이터를 다시 채움
  # (backend/migrations/migrate.sh, infra/ansible README 12-5)
  main:
    resetOnDowngrade: true
  payment:
    enabled: false

# dev 초기 데이터(seed.ts) — 운영과 같은 차트 seed Job. 마이그레이션 hook 뒤, 배포 버전과 같은 seed 이미지로 실행 (멱등)
# 객실 사진은 DB 노드 MinIO 의 room-images 버킷
seed:
  enabled: true
  env:
    S3_REGION: ap-northeast-2
    S3_BUCKET: room-images
    S3_FORCE_PATH_STYLE: "true"
  # 리스트는 차트 기본값을 덮어쓰므로 DB_* · REDIS_*(시딩 후 hotel-service 조회 캐시 비우기) 도 다시 적음
  secretEnv: [DB_HOST, DB_USERNAME, DB_PASSWORD, DB_DATABASE, REDIS_HOST, REDIS_PASSWORD, S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY]
  # 관리자 계정 — Secret seed-admin 의 key 전체를 env 로 (OpenBao seed-admin → ESO, 속성 이름 = 환경변수 이름, infra/ansible README 7-5)
  # 계정 비밀번호 추가 · 변경은 OpenBao 만 (SEED_ADMIN_EMAIL · SEED_ADMIN_PASSWORD 필수, 지점 계정 SEED_*_PASSWORD 선택)
  adminSecretName: seed-admin
