# AWS EKS prod 클러스터 (agent: team04/infra/k8s-agents:prod-agent, namespace: backend)
# ⚠️ 아직 사용하지 않음 — EKS 스택과 prod-agent 설치, ECR push 인증이 준비되면 채웁니다.
#    CI deploy-prod job 은 PROD_DEPLOY_ENABLED=true 가 되기 전까지 실행되지 않습니다.
global:
  # Terraform live/prod/11-registry 출력 repository_urls 의 레지스트리 부분 (<account>.dkr.ecr.us-east-1.amazonaws.com)
  imageRegistry: ""
  imageRepositoryPrefix: team04-hotel/
  imageTag: ""
  # EKS 노드 IAM 역할로 ECR 을 pull → pull secret 불필요
  imagePullSecrets: []

ingress:
  enabled: true
  className: alb
  host: ""
  annotations:
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/healthcheck-path: /health
  paths:
    - /api

defaultResources:
  requests:
    cpu: 100m
    memory: 256Mi
  limits:
    cpu: "1"
    memory: 1Gi
