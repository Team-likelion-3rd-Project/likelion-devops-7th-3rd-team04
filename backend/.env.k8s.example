# gitops/scripts/sync-backend-secrets.sh가 읽는 파일의 템플릿입니다.
# backend/.env.k8s로 복사해서 실제 값을 채우세요 (.gitignore의 .env* 패턴에 걸려 git에는
# 올라가지 않습니다).
#
# DB_HOST/REDIS_HOST는 여기 적을 필요 없습니다 — 스크립트가 Terraform state에서 자동으로
# 읽어옵니다 (EC2 MariaDB private IP / ElastiCache 엔드포인트).

# REDIS_TLS: infra/terraform/modules/redis/main.tf에 transit_encryption_enabled가
# 설정되어 있지 않아(auth_token도 없음) 실제 ElastiCache 클러스터는 인증/TLS가 꺼져 있는
# 상태입니다. false로 두세요.
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hotel_service

REDIS_PASSWORD=
REDIS_TLS=false

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# pg-mock-service ↔ api-gateway 간 결제 웹훅 HMAC 서명 공유키. 둘 다 backend-secrets의
# 이 값을 참조하므로 여기 한 곳만 채우면 됩니다.
MOCK_PG_SECRET=
