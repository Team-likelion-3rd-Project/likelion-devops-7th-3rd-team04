# DB 시딩 전용 one-shot 컨테이너용 Dockerfile.
# nest build를 거치지 않고 scripts/seed.ts를 ts-node로 바로 실행합니다(별도 nest-cli 프로젝트로
# 등록하지 않음). apps/*/Dockerfile의 빌드 스테이지와 동일하게 전체 소스를 복사한 뒤 실행합니다.
# admin 계정 시딩의 경우 seed.ts에 명시되어 있는 환경변수를 설정해줘야 합니다

FROM node:20-alpine

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci

COPY . .

CMD ["npx", "ts-node", "--transpile-only", "-r", "tsconfig-paths/register", "scripts/seed.ts"]
