# ── MariaDB ────────────────────────────────────────────────────────────────
# 이 DB_* 값은 아래 세 곳에서 그대로 쓰입니다 (값을 바꾸면 각각 재기동/재실행만 하면 됨).
#   1) backend 서비스(TypeORM) 접속 정보
#   2) 로컬 docker-compose 의 mariadb 컨테이너 초기화 (MARIADB_USER/PASSWORD/ROOT_PASSWORD 로 매핑)
#   3) 온프레미스 dev DB 노드 — infra/ansible/db.yml 이 이 파일을 직접 읽어 계정을 맞춤
#
# DB_HOST: 로컬 docker compose 는 컨테이너 이름(mariadb),
#          온프레미스 dev 는 DB 노드의 Tailscale IP (db.yml 실행 결과에 출력됨)
DB_HOST=mariadb
DB_PORT=3306
# 앱 전용 계정을 사용하세요 — root 는 쓰지 않습니다.
#   - 앱 계정은 DB_DATABASE 에 대해서만 전체 권한(synchronize 의 테이블 생성 포함)을 가집니다.
#   - mariadb 공식 이미지는 MARIADB_USER=root 를 거부하므로 root 로 두면 로컬 컨테이너가 기동되지 않고,
#     db.yml 도 root 이면 중단됩니다.
# 비밀번호에는 공백, 따옴표, 역슬래시, $, #, ` 를 쓰지 마세요 (.env / DB 설정 파일에 그대로 들어감).
DB_USERNAME=hotel_app
DB_PASSWORD=change-me-app
DB_DATABASE=hotel_service
# DB_SSL: 메인 DB 접속에 TLS 사용 (true / false, 비우면 false = 평문).
#   로컬 docker compose·온프레미스는 비워 두고, 운영 RDS(require_secure_transport = ON)는 true.
#   true면 DB_SSL_CA_PATH(서버 인증서를 검증할 CA 파일, PEM)가 반드시 필요합니다 — 없으면 기동 시 실패.
#   운영 CA 파일(RDS CA 번들)은 인프라가 파드에 마운트하고 경로를 넣습니다. 인증서 검증은 끌 수 없습니다.
DB_SSL=
DB_SSL_CA_PATH=
# DB_LOGGING: 실행한 SQL 문장을 로그로 남김 (true만 켜짐, 기본 꺼짐). 값(PARAMETERS)은 켜도 남기지 않습니다 (LDP-163).
#   실패한 쿼리와 느린 쿼리(DB_SLOW_QUERY_MS, 기본 1000ms 초과)는 항상 값 없이 남습니다.
DB_LOGGING=
DB_SLOW_QUERY_MS=
# METRICS_PORT: Prometheus 메트릭 포트 (GET /metrics, LDP-168). 비우면 메트릭 서버와 요청 측정을 모두 끔.
#   배포 환경은 인프라(차트·결제 노드)가 9464로 넣어 줍니다. 로컬에서 확인할 때만 9464 등으로 지정하세요.
METRICS_PORT=
# MariaDB root 비밀번호 — DB 초기화/관리 전용이며 backend 서비스는 사용하지 않습니다.
# root 는 DB 서버 내부(localhost)에서만 접속 가능하도록 구성됩니다.
DB_ROOT_PASSWORD=change-me-root

# ── 결제 DB (payment-service 전용) ─────────────────────────────────────────
# 결제 데이터는 메인 DB(DB_DATABASE)와 분리된 결제 DB에 둡니다 (ERD 위키 "결제 DB").
#   - 로컬 docker compose: 같은 mariadb 컨테이너 안에 별도 DB/계정을 자동 생성 (scripts/mariadb-init/)
#   - 온프레미스 dev: 결제 서버 노드(infra/ansible/payment.yml)가 이 PORT/DATABASE/USERNAME/PASSWORD 로
#     결제 DB·계정을 만들고 같은 노드의 payment-service 에 넣습니다 (PAYMENT_DB_HOST 는 노드 안에서 127.0.0.1 로 덮어씀).
#     dev 클러스터에는 payment-service 를 배포하지 않으며 이 값도 넣지 않습니다 (infra/ansible/README.md 14절)
#   - AWS: 결제 VPC의 별도 RDS
# 테이블은 Flyway(apps/payment-service/migrations)가 만듭니다 — docker compose의 payment-db-migration.
# 비밀번호 규칙은 위 DB_PASSWORD와 같습니다.
PAYMENT_DB_HOST=mariadb
PAYMENT_DB_PORT=3306
PAYMENT_DB_USERNAME=payment_app
PAYMENT_DB_PASSWORD=change-me-payment
PAYMENT_DB_DATABASE=payment_db
# PAYMENT_DB_SSL / PAYMENT_DB_SSL_CA_PATH: 결제 DB 접속 TLS — 규칙은 위 DB_SSL / DB_SSL_CA_PATH와 같습니다.
#   온프레미스 dev 결제 노드(payment.yml)는 이 값을 쓰지 않습니다 (같은 노드 loopback 이라 평문).
PAYMENT_DB_SSL=
PAYMENT_DB_SSL_CA_PATH=

# ── 결제 PG (payment-service) ─────────────────────────────────────────────
# PAYMENT_PROVIDER: 결제 승인에 쓸 PG. MOCK(기본, pg-mock-service — 로컬·성능 테스트) / TOSS(토스페이먼츠)
#   프론트의 VITE_PAYMENT_MODE 와 같은 값으로 맞춥니다 (위키 API 명세 5.9).
PAYMENT_PROVIDER=MOCK
# TOSS_SECRET_KEY: 토스 "결제위젯 연동 키"의 시크릿 키 (테스트 키는 test_gsk_ 로 시작). PAYMENT_PROVIDER=TOSS 일 때만 필요.
#   ⚠️ 절대 커밋·공유하지 마세요 — 각자 .env 에만 넣습니다. 온프레미스 dev 결제 노드는 infra/ansible/payment.yml 이
#   이 파일의 PAYMENT_PROVIDER · TOSS_* 를 읽어 payment-service 에 넣습니다 (infra/ansible/README.md 14-2).
#   개발자센터 → API 키 → "주문서형·결제창형 연동 키(결제위젯 연동 키)"의 테스트 키를 씁니다 (LDP-91).
#   지금은 문서용 테스트 키(test_gsk_docs_…)를 사용 — 내 키는 전자결제 이용 신청 후 발급. 프론트 클라이언트 키(test_gck_…)와 같은 줄의 한 쌍이어야 합니다.
#   문서용 키는 주문번호 조회가 막혀 있어 결제 조회는 결제 번호(paymentKey)로 합니다.
TOSS_SECRET_KEY=
# TOSS_API_BASE_URL: 비우면 https://api.tosspayments.com (테스트·운영 같은 주소, 키로 구분)
TOSS_API_BASE_URL=

# ── 결제 결과 이벤트 큐 (payment-service 발행 → booking-service 수신, LDP-26) ───────
# 로컬 docker compose 는 아래 값을 비워 두면 compose 의 ElasticMQ(SQS 대체) 기본값을 씁니다 — 보통 안 건드려도 됩니다.
#   SQS_ENDPOINT             : 로컬 기본 http://elasticmq:9324 / 온프레미스 dev 는 결제 서버 ElasticMQ / AWS 는 빈 값(=SQS 기본 주소)
#   SQS_REGION               : 로컬 기본 ap-northeast-2
#   PAYMENT_RESULT_QUEUE_URL : 로컬 기본 http://elasticmq:9324/000000000000/payment-result.fifo
# 이름은 인프라와 확정한 것과 같습니다 (infra/ansible/README.md 14-6). AWS_ACCESS_KEY_ID 등은 로컬에서 넣지 않아도
# ElasticMQ 용 더미값을 코드가 채웁니다.
# 온프레미스 dev 결제 노드(payment.yml)는 이 값을 읽지 않고 항상 노드의 ElasticMQ 를 씁니다.
# SQS_ENDPOINT=
# SQS_REGION=
# PAYMENT_RESULT_QUEUE_URL=

# api-gateway가 허용할 프론트엔드 origin (apps/api-gateway/src/main.ts).
# 로컬: Vite dev 서버 기본 포트. 운영: 배포된 프론트엔드 도메인(예: prod는
# https://www.team04-hotel-prod.kro.kr)으로 교체 — gitops/backend/overlays/{dev,prod}/
# api-gateway-cors-patch.yaml에 그 값이 환경별로 설정되어 있습니다.
CORS_ORIGIN=http://localhost:5173
# THROTTLE_LIMIT: api-gateway 전역 요청 제한 — IP당 1분 동안 허용하는 요청 수 (LDP-186). 비우면 100.
#   k6 부하 테스트(한 IP에서 전송) 때만 크게 올립니다 (1분 기준이라 초당 500건이면 30,000 이상).
#   토큰 재발급·챗봇처럼 @Throttle()로 따로 정한 라우트의 한도는 바뀌지 않습니다.
THROTTLE_LIMIT=

# auth-service가 회원가입 시 발급하는 JWT 서명 secret (운영 환경에서는 반드시 강력한 값으로 교체)
JWT_ACCESS_SECRET=dev-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
# 리프레시 토큰은 JWT_REFRESH_EXPIRES_IN(슬라이딩 윈도우) 안에서 활동만 있으면 로테이션으로
# 계속 재발급되어, 최초 로그인 후 계속 접속하면 세션이 이론상 무기한 유지됩니다. auth-service가
# 최초 로그인 시각을 기준으로 이 값(일)이 지나면 로테이션을 거부하고 강제 재로그인시킵니다.
JWT_REFRESH_ABSOLUTE_MAX_DAYS=30

# auth-service가 리프레시 토큰을 저장하는 Redis (로그아웃 시 삭제 → 재발급 차단)
# 로컬: docker-compose의 redis 컨테이너를 사용 (REDIS_HOST=redis, 인증/TLS 불필요)
# 운영(AWS ElastiCache): REDIS_HOST를 ElastiCache 엔드포인트로, REDIS_PASSWORD를 AUTH 토큰으로,
#   REDIS_TLS=true로 바꾸면 됩니다 (코드 변경 불필요).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# chat-bot-service가 세션/대화 이력을 저장하는 DynamoDB.
# 로컬: docker-compose의 dynamodb-local 컨테이너 (DYNAMODB_ENDPOINT=http://dynamodb-local:8000).
#   AWS_ACCESS_KEY_ID/SECRET은 여기 설정할 필요가 없습니다 — DynamoDB Local은 자격 증명을
#   검증하지 않고, dynamodb.module.ts/dynamodb-init.ts가 값이 없으면 'local'로 기본값을
#   채우도록 이미 짜여 있습니다.
# 운영(AWS DynamoDB): DYNAMODB_ENDPOINT를 비우면 EKS pod identity(chatbot_service IAM 역할)로
#   인증됩니다 (코드 변경 불필요).
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
DYNAMODB_REGION=ap-northeast-2

# hotel-service가 객실 이미지를 저장하는 S3 호환 저장소 (LDP-88). 버킷은 비공개라 사진 보기·올리기 모두
# hotel-service가 발급한 Presigned URL로 접근합니다. DB(room_images.object_key)에는 경로만 저장합니다.
# 로컬: 아래 값을 비워 두면 docker-compose가 minio 컨테이너 기본값을 넣습니다
#   (S3_ENDPOINT=http://minio:9000, S3_PUBLIC_ENDPOINT=http://localhost:9000, 키 = MINIO_ROOT_*).
#   Presigned URL은 서명에 주소가 들어가서, 브라우저가 여는 주소(S3_PUBLIC_ENDPOINT)로 서명합니다.
# 온프레미스 dev: S3_ENDPOINT=http://<DB 노드 Tailscale IP>:9000 (S3_PUBLIC_ENDPOINT는 비우면 같은 값),
#   키 = MinIO 앱 계정(MINIO_APP_ACCESS_KEY/SECRET, infra/ansible README 7-6)
# 운영(AWS S3): S3_ENDPOINT·S3_PUBLIC_ENDPOINT·키를 비우고 S3_FORCE_PATH_STYLE=false →
#   IAM 역할(IRSA)로 인증됩니다 (코드 변경 불필요).
# IMAGE_BASE_URL: 사진 보기 고정 주소. 값이 있으면 Presigned URL 대신 서명 없는 <IMAGE_BASE_URL>/<objectKey> 를 내려줍니다.
#   운영만 https://<도메인> (CloudFront 가 /room-types/* 를 버킷으로 연결, Terraform 13-frontend). 로컬 · 온프레미스는 비워 둡니다.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=room-images
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMAGE_BASE_URL=

# chat-bot-service가 AI 처리를 위임하는 n8n workflow의 webhook 주소.
# chat-bot-service는 backend/docker-compose.yml의 컨테이너 안에서 실행되고, n8n은 별도
# Compose 프로젝트(langchain_rag/docker-compose.yml)의 컨테이너라 localhost로는 자기 자신만
# 가리킵니다. host.docker.internal(Docker Desktop이 기본 제공)로 호스트에 게시된 n8n 포트에
# 접근합니다.
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/chat
N8N_TIMEOUT_MS=30000

# db-seed 서비스(scripts/seed.ts)가 docker compose 최초 기동 시 1회 생성하는 관리자 계정.
# Swagger에서 POST /api/auth/admin/login 테스트 시 아래 평문 비밀번호를 그대로 입력하면 됩니다
# (admin_credentials에는 해시만 저장되고 평문은 여기 .env에만 남습니다. 이미 계정이 있으면 건너뜁니다).
# 아래 비밀번호는 로컬 전용 예시입니다. dev·운영은 따로 정해 비밀 채널로 공유하고 저장소에 올리지 않습니다.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=본사 관리자
# 시드가 채울 객실 예약 가능일 기간(오늘부터 며칠). 다시 실행하면 이 기간 중 빠진 날짜만 추가됩니다. 기본 365
SEED_AVAILABILITY_DAYS=365

# pg-mock-service(실제 PG사 서버 대신 결제 승인/취소를 흉내내는 목업)가 승인/취소 결과를
# 웹훅으로 통보할 대상 URL. 웹훅 수신 엔드포인트는 api-gateway의 POST /api/payments/webhook에
# 있습니다(payment-service는 gRPC 전용이라 직접 못 받음). 비워두면 docker-compose.yml이
# http://api-gateway:3000/api/payments/webhook을 기본값으로 채우므로, 로컬 docker compose
# 실행 시에는 보통 비워둬도 됩니다. 값을 채우면 그 기본값 대신 사용됩니다.
PAYMENT_SERVICE_WEBHOOK_URL=
# pg-mock-service가 웹훅 payload에 서명하고 api-gateway가 검증할 때 쓰는 공유 비밀키(목업용).
# 두 서비스가 반드시 같은 값을 써야 서명 검증이 통과합니다.
MOCK_PG_SECRET=mock-pg-secret