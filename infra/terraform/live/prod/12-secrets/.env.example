# 12-secrets 운영 비밀값. 복사해서 같은 디렉터리의 .env 로 저장하고 채운다 (.env 는 gitignore).
# terragrunt apply 가 이 파일을 읽어 넘긴다 (export 불필요, README 5절).
# 값을 바꾼 Secret 은 variables.tf 의 *_version 을 올려야 실제로 다시 들어간다.

# Tailscale 콘솔 OAuth client secret (tag:ci-runner). tskey-client-*
TS_CI_RUNNER_OAUTH_CLIENT_SECRET=

# 온프레미스 GitLab 주소와 AWS Runner(aws-ci-runner) 인증 토큰. gitlab.yml --tags runner_token 출력(.secrets/aws-ci-runner.env)의 값
GITLAB_URL=
GITLAB_RUNNER_TOKEN=

# gitops 릴리스 PR 용 GitHub App. App ID · Installation ID 는 숫자, 개인 키는 레포 밖 .pem 파일 경로(절대 경로 또는 ~)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=

# 토스페이먼츠 결제위젯 연동 키의 시크릿 키 (테스트 test_gsk_*). 클라이언트 키(test_gck_*)는 넣지 않는다
TOSS_SECRET_KEY=
