# argo-cd chart values — 72 EKS (argocd.tf). 70 은 Ansible roles/argocd argocd-values-aws.yaml.j2 — 같이 고친다.
#
# 70 과 다른 점: EKS 에는 CP 노드가 없어, 운영 도구용 platform 노드 그룹(nodes.tf, LDP-248)에 둔다.
# cluster-admin 을 가진 application-controller 가 앱 파드와 다른 노드에서 돈다.

configs:
  cm:
    # 추적은 annotation 으로 — 차트가 붙이는 app.kubernetes.io/instance 라벨과 섞이지 않게
    application.resourceTrackingMethod: annotation
    admin.enabled: true
    # root(app-of-apps)가 sync-wave 순서대로 하위 Application 이 준비되기를 기다리게 하는 헬스 체크.
    # Healthy = 하위 앱 Healthy + Synced + 마지막 source(gitops ref values)가 root 가 넘긴 커밋을 반영함.
    # 커밋 비교가 없으면 root 가 하위 앱 spec 을 바꾼 직후, 이전 비교 결과(Synced)로 먼저 통과할 수 있다
    resource.customizations.health.argoproj.io_Application: |
      hs = {status = "Progressing", message = ""}
      if obj.status == nil or obj.status.health == nil then
        return hs
      end
      hs.status = obj.status.health.status
      if obj.status.health.message ~= nil then
        hs.message = obj.status.health.message
      end
      if hs.status ~= "Healthy" then
        return hs
      end
      if obj.status.sync == nil or obj.status.sync.status ~= "Synced" then
        hs.status = "Progressing"
        hs.message = "sync 대기"
        return hs
      end
      if obj.spec.sources ~= nil then
        local want = obj.spec.sources[#obj.spec.sources].targetRevision
        local revs = obj.status.sync.revisions
        if revs == nil or revs[#revs] ~= want then
          hs.status = "Progressing"
          hs.message = "커밋 반영 대기 " .. tostring(want)
        end
      end
      return hs
    # 컨트롤러가 런타임에 넣는 caBundle 은 비교에서 뺀다 (cert-manager cainjector · ESO cert-controller)
    resource.customizations.ignoreDifferences.admissionregistration.k8s.io_MutatingWebhookConfiguration: |
      jqPathExpressions:
        - '.webhooks[]?.clientConfig.caBundle'
    resource.customizations.ignoreDifferences.admissionregistration.k8s.io_ValidatingWebhookConfiguration: |
      jqPathExpressions:
        - '.webhooks[]?.clientConfig.caBundle'
    resource.customizations.ignoreDifferences.apiextensions.k8s.io_CustomResourceDefinition: |
      jqPathExpressions:
        - '.spec.conversion.webhook.clientConfig.caBundle'
  params:
    # root sync 가 이 시간 안에 끝나지 않으면(하위 앱이 Healthy 가 되지 않음) 실패로 끝내고 SyncFail 알림을 보낸다.
    # 자동 롤백은 없고 하위 앱은 계속 재시도한다. 첫 sync(재생성)는 전체 설치를 포함하므로 넉넉히 잡는다
    controller.sync.timeout.seconds: "${sync_timeout_seconds}"

# 모든 구성 요소를 platform 노드에 (nodes.tf platform_label · taint 와 같은 값)
global:
  nodeSelector:
    role: platform
  tolerations:
    - key: dedicated
      operator: Equal
      value: platform
      effect: NoSchedule

dex:
  enabled: false

notifications:
  enabled: false

# root 는 app-of-apps 라 ApplicationSet 을 쓰지 않음 (차트에 enabled 플래그가 없어 replicas 0)
applicationSet:
  replicas: 0

controller:
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      memory: 1Gi

# server · repo-server 는 2개 · 영역마다 1개 (platform 노드가 영역마다 1대, LDP-259) — 한 영역 장애에도 UI · 매니페스트 생성이 이어진다.
# application-controller · redis 는 1개 — 이중화하려면 redis-ha 3개가 노드 3대에 떠야 한다. 둘 다 디스크가 없어 영역 장애 때
# 다른 영역 platform 노드로 옮겨진다. labelSelector 를 비우면 차트가 구성 요소의 selector 를 넣는다
repoServer:
  replicas: 2
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: topology.kubernetes.io/zone
      whenUnsatisfiable: DoNotSchedule
  pdb:
    enabled: true
    minAvailable: 1
  # git 저장소를 받아 두는 임시 공간(emptyDir)이라 내보내져도 다시 받으면 된다 — Cluster Autoscaler 축소를 막지 않게 (LDP-248)
  podAnnotations:
    cluster-autoscaler.kubernetes.io/safe-to-evict: "true"
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 512Mi

server:
  replicas: 2
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: topology.kubernetes.io/zone
      whenUnsatisfiable: DoNotSchedule
  pdb:
    enabled: true
    minAvailable: 1
  service:
    type: ClusterIP
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      memory: 256Mi

redis:
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      memory: 256Mi
