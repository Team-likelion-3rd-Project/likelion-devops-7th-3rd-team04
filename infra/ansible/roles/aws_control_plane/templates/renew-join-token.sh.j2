#!/bin/bash
# Ansible(roles/aws_control_plane) 이 관리. 새 bootstrap token 을 만들어 워커가 읽는 join-token 파라미터를 덮어쓴다
set -euo pipefail

token=$(kubeadm token create --kubeconfig /etc/kubernetes/admin.conf --ttl {{ kubeadm_join_token_renew_ttl }})

# token 이 프로세스 인자(ps) 에 보이지 않도록 파일로 넘긴다
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
printf '%s' "$token" > "$tmp"

aws ssm put-parameter --region {{ aws_region }} \
  --name {{ kubeadm_param_prefix }}/join-token \
  --value "file://$tmp" --overwrite > /dev/null

echo "join-token 갱신 (ttl {{ kubeadm_join_token_renew_ttl }})"
