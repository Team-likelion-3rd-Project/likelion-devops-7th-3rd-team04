# Ansible(roles/gitops_sync) 이 관리. 상태 ConfigMap(gitops-sync-state)은 agent 가 만든다
apiVersion: v1
kind: Namespace
metadata:
  name: {{ gitops_sync_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gitops-sync
  namespace: {{ gitops_sync_namespace }}
---
# CRD · ClusterRole 을 설치하는 차트(Traefik 등)가 있어 cluster-admin. ArgoCD application-controller 와 같은 신뢰 모델
# (읽는 곳은 ruleset 으로 보호된 gitops 레포 하나)
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: gitops-sync
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: gitops-sync
    namespace: {{ gitops_sync_namespace }}
---
# 개발 중 작업 브랜치 검증: kubectl -n {{ gitops_sync_namespace }} edit configmap gitops-sync-config 의 BRANCH.
# 검증이 끝나면 main 으로 되돌린다 (매일 재생성 때도 group_vars 의 값으로 다시 만들어진다)
apiVersion: v1
kind: ConfigMap
metadata:
  name: gitops-sync-config
  namespace: {{ gitops_sync_namespace }}
data:
  REPO_URL: {{ gitops_sync_repo_url | to_json }}
  BRANCH: {{ gitops_sync_branch | to_json }}
  APPS_PATH: {{ gitops_sync_apps_path | to_json }}
  HELM_TIMEOUT: {{ gitops_sync_helm_timeout | to_json }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: gitops-sync-script
  namespace: {{ gitops_sync_namespace }}
data:
  gitops-sync.sh: |
    {{ lookup('ansible.builtin.file', 'gitops-sync.sh') | indent(4) }}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: gitops-sync
  namespace: {{ gitops_sync_namespace }}
spec:
  schedule: {{ gitops_sync_schedule | to_json }}
  # 부트스트랩 Job 과 겹쳐 helm 이 동시에 돌지 않도록 멈춘 채로 만들고, 부트스트랩이 끝나면 role 이 해제한다
  suspend: true
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 120
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      # 실패 기록 · 재시도 판단은 스크립트가 한다
      backoffLimit: 0
      activeDeadlineSeconds: 1800
      ttlSecondsAfterFinished: 3600
      template:
        spec:
          serviceAccountName: gitops-sync
          restartPolicy: Never
          # cluster-admin 토큰을 앱 파드가 뜨는 워커와 분리한다
          nodeSelector:
            node-role.kubernetes.io/control-plane: ""
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              operator: Exists
              effect: NoSchedule
          securityContext:
            runAsNonRoot: true
            runAsUser: 65534
            runAsGroup: 65534
            seccompProfile:
              type: RuntimeDefault
          containers:
            - name: sync
              image: {{ gitops_sync_image | to_json }}
              command: ["bash", "/opt/gitops-sync/gitops-sync.sh"]
              envFrom:
                - configMapRef:
                    name: gitops-sync-config
              env:
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                # git · helm 캐시 · 설정
                - name: HOME
                  value: /tmp
              securityContext:
                allowPrivilegeEscalation: false
                readOnlyRootFilesystem: true
                capabilities:
                  drop: ["ALL"]
              resources:
                requests:
                  cpu: 50m
                  memory: 128Mi
                limits:
                  memory: 512Mi
              volumeMounts:
                - name: script
                  mountPath: /opt/gitops-sync
                  readOnly: true
                - name: tmp
                  mountPath: /tmp
          volumes:
            - name: script
              configMap:
                name: gitops-sync-script
            - name: tmp
              emptyDir:
                sizeLimit: 1Gi
