apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ k8s_api_endpoint }}"
    token: "{{ k8s_join_token }}"
    caCertHashes:
      - "{{ k8s_ca_cert_hash }}"
nodeRegistration:
  name: "{{ node_name }}"
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ node_ip }}"
{% if kubelet_cloud_provider is defined %}
    - name: cloud-provider
      value: "{{ kubelet_cloud_provider }}"
{% endif %}
