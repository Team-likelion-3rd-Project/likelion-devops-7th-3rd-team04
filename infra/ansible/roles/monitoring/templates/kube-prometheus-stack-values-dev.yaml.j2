# kube-prometheus-stack chart {{ kube_prometheus_stack_chart_version }} dev values — Ansible(roles/monitoring) 이 관리. 직접 수정 금지
#
# files/kube-prometheus-stack-values-common.yaml 위에 겹침 (helm -f common -f dev). 여기에는 dev 환경 값만 둡니다.
# 배치 — 관측성은 클러스터 기동에 필수가 아니라 control plane(vCPU 2)의 부담을 줄이도록 워커 우선 (README 17절)
#   operator · admission patch Job · kube-state-metrics : 워커 우선, 워커가 모두 꺼져 있으면 control plane
#     (상태 없음 — 워커가 꺼지면 약 5분 뒤 다른 노드로 다시 뜸)
#   Prometheus : control plane 고정 — 데이터가 control plane 로컬 PV. CPU limit 으로 control plane 을 보호
#   Grafana : control plane 고정 — tailscale serve(CP)는 다른 노드의 Pod 로 프록시하지 못함 (README 17-7, ArgoCD 와 같은 이유)
#   node-exporter : DaemonSet (모든 노드)

prometheusOperator:
  affinity: &prefer_workers
    nodeAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: node-role.kubernetes.io/control-plane
                operator: DoesNotExist
  tolerations: &cp_tolerations
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule
  admissionWebhooks:
    patch:
      affinity: *prefer_workers
      tolerations: *cp_tolerations

kube-state-metrics:
  affinity: *prefer_workers
  tolerations: *cp_tolerations

prometheus:
  # 결제 노드 Alloy 의 remote_write 수신 (control plane Tailscale IP:{{ prometheus_nodeport }})
  service:
    type: NodePort
    nodePort: {{ prometheus_nodeport }}
  prometheusSpec:
    # 로컬 PV(prometheus-local)가 control plane 에 있어 고정
    nodeSelector:
      node-role.kubernetes.io/control-plane: ""
    tolerations: *cp_tolerations
    # 모든 ServiceMonitor · PodMonitor 수집 대상에 cluster · env 라벨을 붙임.
    # externalLabels 는 저장된 시계열에 붙지 않아(remote_write · 알림에만 붙음) 쿼리 sum by (cluster) 에 쓸 수 없음.
    # 결제 노드는 Alloy 가 cluster="payment" 로 보냄
    scrapeClasses:
      - name: team04-default
        default: true
        relabelings:
          - targetLabel: cluster
            replacement: main
            action: replace
          - targetLabel: env
            replacement: {{ monitoring_env }}
            action: replace
    externalLabels:
      cluster: main
      env: {{ monitoring_env }}
    retention: {{ prometheus_retention }}
    retentionSize: {{ prometheus_retention_size }}
    # control plane 로컬 PV (roles/monitoring 이 StorageClass monitoring-local · PV 를 만듦)
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: monitoring-local
          accessModes: [ReadWriteOnce]
          resources:
            requests:
              storage: {{ prometheus_storage_gb }}Gi
    # CPU limit: control plane 의 apiserver · etcd · controller-manager 몫을 남김 (넘으면 수집 · 쿼리가 느려질 뿐 죽지 않음)
    resources:
      requests:
        cpu: 100m
        memory: 512Mi
      limits:
        cpu: {{ prometheus_cpu_limit | to_json }}
        memory: 2Gi

grafana:
  # 9443 의 tailscale serve 가 CP 에서 NodePort 로 프록시 — Pod 가 워커에 있으면 응답이 오지 않음 (README 17-7)
  nodeSelector:
    node-role.kubernetes.io/control-plane: ""
  tolerations: *cp_tolerations
  service:
    type: NodePort
    nodePort: {{ grafana_nodeport }}
  grafana.ini:
    server:
      # TLS 는 앞단 tailscale serve 가 종료 (*.ts.net Let's Encrypt)
      root_url: "https://{{ monitoring_fqdn }}:{{ grafana_serve_https_port }}"
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 512Mi
