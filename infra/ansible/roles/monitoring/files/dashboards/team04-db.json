    {
      "id": 20,
      "type": "row",
      "title": "결제 DB — 서버 (MariaDB, cluster=payment)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "exporter 접속",
      "description": "0 이면 exporter 가 MariaDB 에 접속하지 못함 (MariaDBDown 알람)",
      "targets": [
        {
