      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(redis_keyspace_hits_total{cluster=\"db\", job=\"redis\"}[$__rate_interval])) / (sum by (instance) (rate(redis_keyspace_hits_total{cluster=\"db\", job=\"redis\"}[$__rate_interval])) + sum by (instance) (rate(redis_keyspace_misses_total{cluster=\"db\", job=\"redis\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}"
