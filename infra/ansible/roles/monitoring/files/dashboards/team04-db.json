      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "maxmemory 를 넘으면 volatile-lru 로 키 축출. 90% 를 5분 넘으면 ValkeyMemoryNearMax",
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 4,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "명령 처리량 · 클라이언트",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(redis_commands_processed_total{cluster=\"db\", job=\"redis\"}[$__rate_interval]))",
          "legendFormat": "명령/s {{instance}}"
        },
        {
          "refId": "B",
          "expr": "max by (instance) (redis_connected_clients{cluster=\"db\", job=\"redis\"})",
          "legendFormat": "클라이언트 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
