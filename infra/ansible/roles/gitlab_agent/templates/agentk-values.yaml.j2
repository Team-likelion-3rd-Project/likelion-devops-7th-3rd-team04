# gitlab-agent chart {{ gitlab_agent_chart_version }} values — Ansible(roles/gitlab_agent) 이 관리. 직접 수정 금지
# (agent 토큰 포함 → 0600)
config:
  token: {{ gitlab_agent_token | to_json }}
  # 내장 nginx 가 /-/kubernetes-agent/ 를 KAS 로 WebSocket 프록시 (앞단 TLS 는 tailscale serve)
  kasAddress: wss://{{ gitlab_fqdn }}/-/kubernetes-agent/
{% if private_ca_cert_file | length > 0 %}
  # 사설 CA 를 쓸 때만 (tailscale serve 의 *.ts.net 인증서는 공인 CA 라 불필요)
  kasCaCert: |
    {{ lookup('ansible.builtin.file', private_ca_cert_file) | indent(4) }}
{% endif %}
  # 클러스터 전체 이미지 스캔 기능 — cluster 권한이 필요하고 쓰지 않으므로 끔
  operational_container_scanning:
    enabled: false

# 기본값은 cluster-admin ClusterRoleBinding → 끄고 roles/gitlab_agent 의 Role 로 대체
rbac:
  create: false

serviceAccount:
  create: true
  name: {{ gitlab_agent_sa }}

# 워커는 팀원 PC 의 VM 이라 꺼질 수 있으므로 control plane 1대에 고정 (Traefik 과 같은 이유)
replicas: 1
nodeSelector:
  node-role.kubernetes.io/control-plane: ""
tolerations:
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule

# Pod 의 CoreDNS 는 MagicDNS(*.ts.net)를 해석한다는 보장이 없어 GitLab 주소를 고정 (Runner 의 extra_hosts 와 같은 이유)
hostAliases:
  - ip: {{ gitlab_ts_ip | to_json }}
    hostnames:
      - {{ gitlab_fqdn | to_json }}

resources:
  requests:
    cpu: 50m
    memory: 128Mi
  limits:
    memory: 256Mi
