# Ansible(payment_stack role)이 생성 — 결제 DB 마이그레이션 (backend/apps/payment-service/migrations)
FLYWAY_URL=jdbc:mariadb://127.0.0.1:{{ payment_db_port }}/{{ payment_db_database }}
FLYWAY_USER={{ payment_db_username }}
FLYWAY_PASSWORD={{ payment_db_password }}
FLYWAY_CONNECT_RETRIES=10
# dev: 이전 태그로 롤백하면(DB 가 이미지보다 앞섬) 결제 DB 를 비우고 그 버전까지 다시 적용 (migrate.sh — 운영은 켜지 않음)
MIGRATE_RESET_ON_DOWNGRADE=true
