# Ansible(payment_stack role)이 생성 — 직접 수정하지 마세요.
# network_mode: host + ufw 로 tailscale0 의 payment-service(gRPC)·ElasticMQ(SQS API) 만 허용
# (Docker 포트 publish 는 ufw 를 우회하므로 사용하지 않음. MariaDB 는 127.0.0.1 에만 바인딩)
name: payment-node

services:
  mariadb:
    image: {{ mariadb_image }}
    container_name: payment-mariadb
    network_mode: host
    restart: unless-stopped
    env_file: [mariadb.env]
    labels:
      payment-node.config-checksum: "{{ pay_mariadb_conf.checksum }}"
    volumes:
      - {{ payment_data_dir }}/mariadb:/var/lib/mysql
      - ./conf/mariadb.cnf:/etc/mysql/conf.d/zz-payment.cnf:ro
      - ./mysql:/etc/mysql/ansible:ro
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 60s

  # dev 용 SQS 대체. 결제 결과 이벤트(payment_outbox) → booking-service(클러스터)가 tailnet 으로 수신
  elasticmq:
    image: {{ elasticmq_image }}
    container_name: elasticmq
    network_mode: host
    restart: unless-stopped
    environment:
      JAVA_TOOL_OPTIONS: "-Xmx{{ elasticmq_heap }}"
    labels:
      payment-node.config-checksum: "{{ pay_elasticmq_conf.checksum }}"
    volumes:
      - ./conf/elasticmq.conf:/opt/elasticmq.conf:ro
      - {{ payment_data_dir }}/elasticmq:/data
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null 'http://127.0.0.1:{{ elasticmq_port }}/?Action=ListQueues' || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

  # 결제 DB 스키마 (Flyway). payment-service 와 같은 커밋으로 빌드된 이미지.
  # profile 로 분리해 up 에서는 뜨지 않고, Ansible 이 앱 갱신 전에 `compose run --rm` 으로 1회 실행
  payment-db-migration:
    image: {{ payment_migrations_image }}
    profiles: [migrate]
    network_mode: host
    restart: "no"
    env_file: [flyway.env]
    command: ["migrate"]

  payment-service:
    image: {{ payment_service_image }}
    container_name: payment-service
    network_mode: host
    restart: unless-stopped
    env_file: [payment.env]
    depends_on:
      mariadb:
        condition: service_healthy
      elasticmq:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:{{ payment_health_port }}/health || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 30s

  # ── 모니터링 수집기 (README 17절) — 셋 다 127.0.0.1 에만 바인딩, Alloy 가 클러스터 Prometheus 로 push ──
  node-exporter:
    image: {{ node_exporter_image }}
    container_name: node-exporter
    network_mode: host
    pid: host
    restart: unless-stopped
    command:
      - --path.rootfs=/host
      - --web.listen-address=127.0.0.1:{{ node_exporter_port }}
    volumes:
      - /:/host:ro,rslave

  # 컨테이너별 CPU · 메모리. cgroup · Docker 메타데이터를 읽기 위해 privileged
  cadvisor:
    image: {{ cadvisor_image }}
    container_name: cadvisor
    network_mode: host
    restart: unless-stopped
    privileged: true
    command:
      - --listen_ip=127.0.0.1
      - --port={{ cadvisor_port }}
      - --docker_only=true
      - --store_container_labels=false
      - --housekeeping_interval=30s
      # 쓰지 않는 지표는 끔 (CPU · 메모리 · 디스크 · 네트워크 · OOM 만 남김)
      - --disable_metrics=advtcp,cpu_topology,cpuset,hugetlb,memory_numa,percpu,perf_event,process,referenced_memory,resctrl,sched,tcp,udp
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro

  alloy:
    image: {{ alloy_image }}
    container_name: alloy
    network_mode: host
    restart: unless-stopped
    labels:
      payment-node.config-checksum: "{{ pay_alloy_conf.checksum }}"
    command:
      - run
      - --server.http.listen-addr=127.0.0.1:{{ alloy_port }}
      - --storage.path=/var/lib/alloy/data
      - /etc/alloy/config.alloy
    volumes:
      - ./conf/config.alloy:/etc/alloy/config.alloy:ro
      # remote_write WAL — 클러스터에 닿지 않는 동안 쌓았다가 다시 보냄
      - {{ payment_data_dir }}/alloy:/var/lib/alloy/data
    depends_on:
      - node-exporter
      - cadvisor
