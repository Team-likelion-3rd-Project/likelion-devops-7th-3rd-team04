# Ansible(payment_stack role)이 생성 — 값은 OpenBao(payment-db · toss-payments), backend/.env(PAYMENT_PROVIDER, TOSS_API_BASE_URL) 와 inventory/group_vars/payment.yml
NODE_ENV=production

# 결제 DB (같은 노드, loopback — PAYMENT_DB_SSL 은 넣지 않아 평문)
PAYMENT_DB_HOST=127.0.0.1
PAYMENT_DB_PORT={{ payment_db_port }}
PAYMENT_DB_USERNAME={{ payment_db_username }}
PAYMENT_DB_PASSWORD={{ payment_db_password }}
PAYMENT_DB_DATABASE={{ payment_db_database }}

# 결제 PG — 비운 값은 쓰지 않아 앱 기본값을 씀 (README 14-2)
PAYMENT_PROVIDER={{ payment_provider }}
{% if payment_provider == 'TOSS' %}
TOSS_SECRET_KEY={{ toss_secret_key }}
{% endif %}
{% if toss_api_base_url | length > 0 %}
TOSS_API_BASE_URL={{ toss_api_base_url }}
{% endif %}

# 클러스터 서비스 (차트 nodePort → control plane Tailscale IP)
BOOKING_SERVICE_HOST={{ cluster_entry_ip }}:{{ booking_nodeport }}
PG_MOCK_SERVICE_URL=http://{{ cluster_entry_ip }}:{{ pg_mock_nodeport }}

{% if payment_metrics_enabled %}
# Prometheus 메트릭 (GET /metrics) — 같은 노드의 Alloy 가 127.0.0.1 로 수집해 클러스터 Prometheus 로 보냄 (README 17절)
METRICS_PORT={{ payment_metrics_port }}

{% endif %}
# 결제 결과 이벤트 발행 (ElasticMQ, 같은 노드)
{% for key, value in payment_sqs_env.items() %}
{{ key }}={{ value }}
{% endfor %}
