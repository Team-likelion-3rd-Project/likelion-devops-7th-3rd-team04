# Ansible(roles/api_gateway_ingress) 이 관리. 향후 ArgoCD 도입 시 앱 매니페스트로 이관 후 삭제
apiVersion: v1
kind: Namespace
metadata:
  name: {{ api_gateway_namespace }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ api_gateway_service }}
  namespace: {{ api_gateway_namespace }}
  labels:
    app.kubernetes.io/managed-by: ansible
spec:
  ingressClassName: traefik
  rules:
    # host 규칙 없음 — MagicDNS 이름 / Tailscale IP 어느 쪽으로 접속해도 라우팅
    - http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: {{ api_gateway_service }}
                port:
                  number: {{ api_gateway_port }}
{% if api_gateway_expose_swagger %}
          - path: /api-docs
            pathType: Prefix
            backend:
              service:
                name: {{ api_gateway_service }}
                port:
                  number: {{ api_gateway_port }}
{% endif %}
