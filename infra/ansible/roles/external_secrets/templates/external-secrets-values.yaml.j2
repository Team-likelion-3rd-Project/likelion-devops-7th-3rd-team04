# External Secrets Operator chart {{ external_secrets_chart_version }} values — Ansible(roles/external_secrets) 이 관리. 직접 수정 금지
#
# 운영은 gitops 레포 envs/prod/external-secrets (Secrets Manager, IRSA). dev 는 OpenBao(Kubernetes auth)
# CRD 는 차트로 설치 (installCRDs 기본 true). ServiceAccount 이름은 OpenBao Kubernetes auth role 의 bound service account 와 같아야 함
serviceAccount:
  name: {{ external_secrets_service_account }}
{% if addons_on_control_plane %}

# 워커는 팀원 PC 라 꺼질 수 있음 → controller · webhook · cert-controller 모두 control plane 에 고정 (traefik 과 같은 방식)
nodeSelector: &cp_node_selector
  node-role.kubernetes.io/control-plane: ""
tolerations: &cp_tolerations
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule

webhook:
  nodeSelector: *cp_node_selector
  tolerations: *cp_tolerations

certController:
  nodeSelector: *cp_node_selector
  tolerations: *cp_tolerations
{% endif %}
