# Traefik chart {{ traefik_chart_version }} values — Ansible(roles/traefik) 이 관리. 직접 수정 금지
#
# 배치 · Service 정책은 traefik_* 값 (기본: control plane 1대 고정). AWS 는 gitops 레포 envs/prod/traefik
deployment:
  replicas: {{ traefik_replicas }}
{% if traefik_on_control_plane %}

nodeSelector:
  node-role.kubernetes.io/control-plane: ""

tolerations:
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule
{% endif %}

ingressClass:
  enabled: true
  isDefaultClass: false
  name: traefik

providers:
  kubernetesIngress:
    enabled: true
    # Ingress status(loadBalancer.ingress)에 진입 주소를 기록 — 비어 있으면 ArgoCD 가 Ingress 를 계속 Progressing 으로 표시.
    # Service 가 NodePort 라 기본값(publishedService)으로는 주소가 채워지지 않음
    publishedService:
      enabled: false
    ingressEndpoint:
      ip: {{ traefik_ingress_endpoint_ip | to_json }}
  kubernetesCRD:
    enabled: true

ports:
  web:
    nodePort: {{ traefik_http_nodeport }}
    # forwardedHeaders.trustedIPs 는 의도적으로 비워 둡니다.
    # 클라이언트가 보낸 X-Forwarded-For(Vite proxy 의 127.0.0.1 등)를 버리고
    # 실제 접속 IP(개발자 PC Tailscale IP)로 다시 써서 api-gateway 가 사용자별로 구분하게 합니다.
  websecure:
    # TLS 는 쓰지 않음 (필요 시 tailscale serve 로 앞단에서 종료)
    expose:
      default: false

service:
  spec:
    type: NodePort
    externalTrafficPolicy: {{ traefik_external_traffic_policy }}

# 클라이언트 IP / 라우팅 확인용
accessLog:
  enabled: true
