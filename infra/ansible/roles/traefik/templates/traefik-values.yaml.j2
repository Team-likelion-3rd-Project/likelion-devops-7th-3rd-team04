# Traefik chart {{ traefik_chart_version }} values — Ansible(roles/traefik) 이 관리. 직접 수정 금지
#
# 워커는 팀원 PC 의 VM 이라 꺼질 수 있으므로 항상 켜져 있는 control plane 1대에 고정합니다.
deployment:
  replicas: 1

nodeSelector:
  node-role.kubernetes.io/control-plane: ""

tolerations:
  - key: node-role.kubernetes.io/control-plane
    operator: Exists
    effect: NoSchedule

ingressClass:
  enabled: true
  isDefaultClass: false
  name: traefik

providers:
  kubernetesIngress:
    enabled: true
  kubernetesCRD:
    enabled: true

ports:
  web:
    nodePort: {{ traefik_http_nodeport }}
    # forwardedHeaders.trustedIPs 는 의도적으로 비워 둡니다.
    # 클라이언트가 보낸 X-Forwarded-For(Vite proxy 의 127.0.0.1 등)를 버리고
    # 실제 접속 IP(개발자 PC Tailscale IP)로 다시 써서 api-gateway 가 사용자별로 구분하게 합니다.
  websecure:
    # TLS 는 쓰지 않음 (필요 시 tailscale serve 로 앞단에서 종료)
    expose:
      default: false

service:
  spec:
    type: NodePort
    # kube-proxy SNAT 없이 개발자 PC 의 출발지 IP 를 보존 (Traefik Pod 가 있는 노드로만 들어옴)
    externalTrafficPolicy: Local

# 클라이언트 IP / 라우팅 확인용
accessLog:
  enabled: true
