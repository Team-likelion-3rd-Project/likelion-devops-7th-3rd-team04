# Ansible(roles/gitlab_runner) 이 관리. 예정 시각에 꺼져 있었으면 다음 부팅 때 실행(Persistent) — 그 주 첫 파이프라인만 캐시 없이 돈다
[Unit]
Description=GitLab Runner weekly cache volume prune

[Timer]
Unit=team04-runner-prune@weekly.service
OnCalendar={{ gitlab_runner_prune_weekly_calendar }}
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
