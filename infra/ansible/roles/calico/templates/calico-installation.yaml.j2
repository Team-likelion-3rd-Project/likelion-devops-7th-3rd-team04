# Tailscale(WireGuard L3) 위에서는 IP-in-IP 가 통과되지 않으므로 VXLAN 사용, BGP 미사용
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    bgp: Disabled
    mtu: {{ calico_mtu }}
    nodeAddressAutodetectionV4:
      interface: "{{ tailscale_interface }}"
    ipPools:
      - name: default-ipv4-ippool
        blockSize: 26
        cidr: "{{ pod_subnet }}"
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
spec: {}
