# Ansible(db_seed role)이 생성 — backend/scripts/seed.ts 실행용 (DB 값은 OpenBao main-db, 관리자 계정은 OpenBao seed-admin · 없으면 backend/.env)
DB_HOST=127.0.0.1
DB_PORT={{ db_port }}
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ db_password }}
DB_DATABASE={{ db_database }}
SEED_ADMIN_EMAIL={{ seed_admin_email }}
SEED_ADMIN_PASSWORD={{ seed_admin_password }}
SEED_ADMIN_NAME={{ seed_admin_name }}
{% for key, value in seed_account_passwords | dictsort %}
{{ key }}={{ value }}
{% endfor %}

S3_ENDPOINT=http://127.0.0.1:{{ minio_api_port }}
S3_REGION={{ minio_region }}
S3_BUCKET={{ minio_bucket }}
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID={{ minio_app_access_key }}
S3_SECRET_ACCESS_KEY={{ minio_app_secret_key }}

# 객실 재고(오늘부터 30일) 날짜를 한국 날짜 기준으로 계산
TZ=Asia/Seoul
