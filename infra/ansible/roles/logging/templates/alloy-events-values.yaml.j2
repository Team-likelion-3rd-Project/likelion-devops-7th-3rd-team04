# grafana/alloy chart {{ alloy_chart_version }} values — 쿠버네티스 Events → Loki (Deployment 1개). Ansible(roles/logging)이 관리, 직접 수정 금지 (README 17-8)
#
# Events(스케줄 실패 · OOMKilled · ImagePullBackOff · Probe 실패 등)는 API 객체라 기본 1시간 뒤 사라짐 → 보존 기간 동안 Loki 에 남김.
# 클러스터에 하나만 있어야 같은 이벤트가 중복되지 않으므로 DaemonSet(alloy-logs)과 따로 둠. 라벨: cluster="main" · env · namespace · job="events"

alloy:
  configMap:
    content: |
      loki.source.kubernetes_events "cluster" {
        job_name   = "events"
        log_format = "logfmt"
        forward_to = [loki.write.main.receiver]
      }

      loki.write "main" {
        endpoint {
          url = "{{ loki_push_url }}"
        }

        external_labels = {
          cluster = "main",
          env     = "{{ monitoring_env }}",
        }
      }

  enableReporting: false
  # 이벤트를 어디까지 보냈는지는 Pod 안(emptyDir)에만 — 다시 뜨면 남아 있는 이벤트(최대 1시간)를 다시 보낼 수 있음
  storagePath: /tmp/alloy

  securityContext:
    allowPrivilegeEscalation: false
    capabilities:
      drop: [ALL]

  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      memory: 128Mi

controller:
  type: deployment
  replicas: 1
  # 상태 없음 → 워커 우선, 워커가 모두 꺼져 있으면 control plane (kube-prometheus-stack 의 operator 와 같은 배치)
  affinity:
    nodeAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: node-role.kubernetes.io/control-plane
                operator: DoesNotExist
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule

# 이벤트 읽기만 (기본값은 secrets · configmaps 읽기 등을 포함). clusterRules: [] 는 chart 렌더링이 깨져서 namespaces 읽기를 둠
rbac:
  rules:
    - apiGroups: [""]
      resources: ["events"]
      verbs: ["get", "list", "watch"]
  clusterRules:
    - apiGroups: [""]
      resources: ["namespaces"]
      verbs: ["get", "list", "watch"]

configReloader:
  resources:
    requests:
      cpu: 10m
      memory: 16Mi
