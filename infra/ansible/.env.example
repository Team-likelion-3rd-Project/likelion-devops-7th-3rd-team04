# cp .env.example .env 후 값을 채우세요. .env 는 gitignore 대상입니다 — 절대 커밋하지 마세요.
# 사용: set -a; source .env; set +a

# WSL 의 /mnt/* 경로는 world-writable 이라 ansible.cfg 가 자동 로드되지 않으므로 명시
ANSIBLE_CONFIG=./ansible.cfg

# Tailscale OAuth client secret (tskey-client-...) — 팀 비밀 채널로 전달받은 값
TS_OAUTH_CLIENT_SECRET=

# (선택) 노드에 부여할 Tailscale 태그. 기본값 tag:k8s-node
# TS_TAGS=tag:k8s-node

# ── worker 전용 ─────────────────────────────────────────────
# control-plane.yml 실행 시 .secrets/join.env 로 자동 생성되므로
# 그 파일을 전달받아 함께 source 하면 됩니다. (직접 채워도 됨)
# K8S_API_ENDPOINT=
# K8S_JOIN_TOKEN=
# K8S_CA_CERT_HASH=

# ── DB 노드 (db.yml) 전용 ───────────────────────────────────
# tag:db 전용 Tailscale OAuth client secret (k8s 용 client 와 분리)
TS_DB_OAUTH_CLIENT_SECRET=
# Valkey requirepass — 추후 backend REDIS_PASSWORD 와 같은 값으로 맞출 예정
# 공백, 따옴표, 역슬래시, $, #, ` 사용 불가
VALKEY_PASSWORD=
# MinIO (dev 용 S3, 객실 이미지) — README 7-6
# 영문, 숫자, . _ ~ - 만 사용. USER / ACCESS_KEY 는 3자 이상, PASSWORD / SECRET_KEY 는 8자 이상
# root 자격증명은 최초 기동 시 1회만 반영
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 앱 전용 계정 (버킷 읽기/쓰기만) — 추후 backend S3 접근 키와 같은 값으로 맞출 예정. root 와 다른 값
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
# RAG 인덱스 전용 계정 (rag-index 버킷 읽기/쓰기만) — llm-service 의 VECTOR_OBJECT_ACCESS_KEY / SECRET_KEY 로도 쓰임
# (db.yml 이 계정을 만들고, k8s-cicd.yml 이 backend-secrets 에 넣음). root / 앱 계정과 다른 값
MINIO_RAG_ACCESS_KEY=
MINIO_RAG_SECRET_KEY=
# DB_* 는 backend/.env 에서 직접 읽습니다. 다른 파일을 쓰려면 경로 지정 (선택, infra/ansible 기준 상대경로 또는 절대경로)
# BACKEND_ENV_FILE=../../backend/.env

# ── GitLab / GitLab Runner 노드 (gitlab.yml, gitlab-runner.yml) 전용 ──
# tag:gitlab 전용 Tailscale OAuth client secret (k8s / DB 용 client 와 분리)
TS_GITLAB_OAUTH_CLIENT_SECRET=
# tag:gitlab-runner 전용 Tailscale OAuth client secret
# (한 client 에 tag:gitlab, tag:gitlab-runner 를 같이 지정하면 tailscale up 이 "requested tags ... not permitted" 로 실패 → client 분리)
TS_GITLAB_RUNNER_OAUTH_CLIENT_SECRET=
# GitLab root 최초 비밀번호 — 최초 기동 시 1회만 반영. 8자 이상, 공백, 따옴표, 역슬래시, $, #, ` 사용 불가
GITLAB_ROOT_PASSWORD=
# Runner 용 GITLAB_URL / GITLAB_TS_IP / GITLAB_RUNNER_TOKEN 은
# gitlab.yml 실행 시 .secrets/gitlab-runner.env 로 자동 생성되므로 그 파일을 함께 source 하면 됩니다.

# ── CI/CD (db.yml, gitlab.yml --tags bootstrap) — README 12절 ──────
# GitLab CI 이미지 smoke test 전용 DB 계정(ci_smoke) 비밀번호. db.yml 이 계정을 만들고,
# gitlab.yml --tags bootstrap 이 team04/hotel CI 변수로 등록 (masked 변수라 8자 이상, 영숫자 위주 권장)
CI_SMOKE_DB_PASSWORD=
# DB 노드 Tailscale IP (db.yml 실행 결과의 DB_HOST 값)
#   gitlab.yml --tags bootstrap: CI smoke test 접속 주소 / k8s-cicd.yml: backend-secrets 의 DB_HOST·REDIS_HOST
DB_TS_IP=
# ── 챗봇 AI 스택 (k8s-cicd.yml → backend-secrets) — README 15절 ─────────────
# llm-service 가 Vertex AI 를 호출할 서비스 계정 키 파일 경로 (infra/gcp-terraform/README 의 키 발급).
# 상대 경로는 infra/ansible 기준. .secrets/ 는 gitignore 대상
GCP_SA_KEY_FILE=.secrets/llm-service-dev-sa.json
# n8n 이 최초 기동 때 만드는 owner 계정 비밀번호 (워크플로 활성화용, 클러스터 밖에 노출되지 않음). 8자 이상
N8N_INIT_OWNER_PASSWORD=
# k8s-cicd.yml 용 GITLAB_URL / GITLAB_TS_IP / GITLAB_REGISTRY / *_AGENT_TOKEN / REGISTRY_DEPLOY_* 는
# gitlab.yml --tags bootstrap 실행 시 .secrets/gitlab-k8s.env 로 자동 생성됩니다.

# ── 결제 서버 노드 (payment.yml) 전용 — README 14절 ─────────────
# tag:payment 전용 Tailscale OAuth client secret
TS_PAYMENT_OAUTH_CLIENT_SECRET=
# 결제 MariaDB root 비밀번호 (최초 초기화 때만 반영). 메인 DB 의 DB_ROOT_PASSWORD 와 다른 값 권장
# 공백, 따옴표, 역슬래시, $, #, ` 사용 불가. PAYMENT_DB_* (앱 계정) 는 backend/.env 에서 읽습니다
PAYMENT_DB_ROOT_PASSWORD=
# control plane Tailscale IP — payment-service 가 booking-service(:30303) / pg-mock-service(:30307) NodePort 로 호출
CLUSTER_ENTRY_IP=
# (선택) 결제 노드 이미지 태그를 직접 지정 (기본: gitops envs/dev/values.yaml 의 global.imageTag)
# PAYMENT_IMAGE_TAG=
# GITLAB_URL / GITLAB_TS_IP / GITLAB_REGISTRY / PAYMENT_DEPLOY_* 는
# gitlab.yml --tags bootstrap 실행 시 .secrets/payment-node.env 로 자동 생성됩니다.
