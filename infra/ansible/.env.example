# cp .env.example .env 후 값을 채우세요. .env 는 gitignore 대상입니다 — 절대 커밋하지 마세요.
# 사용: set -a; source .env; set +a

# WSL 의 /mnt/* 경로는 world-writable 이라 ansible.cfg 가 자동 로드되지 않으므로 명시
ANSIBLE_CONFIG=./ansible.cfg

# Tailscale OAuth client secret (tskey-client-...) — 팀 비밀 채널로 전달받은 값
TS_OAUTH_CLIENT_SECRET=

# (선택) 노드에 부여할 Tailscale 태그. 기본값 tag:k8s-node
# TS_TAGS=tag:k8s-node

# ── worker 전용 ─────────────────────────────────────────────
# control-plane.yml 실행 시 .secrets/join.env 로 자동 생성되므로
# 그 파일을 전달받아 함께 source 하면 됩니다. (직접 채워도 됨)
# K8S_API_ENDPOINT=
# K8S_JOIN_TOKEN=
# K8S_CA_CERT_HASH=

# ── DB 노드 (db.yml) 전용 ───────────────────────────────────
# tag:db 전용 Tailscale OAuth client secret (k8s 용 client 와 분리)
# TS_DB_OAUTH_CLIENT_SECRET=
# Valkey requirepass — 추후 backend REDIS_PASSWORD 와 같은 값으로 맞출 예정
# 공백, 따옴표, 역슬래시, $, #, ` 사용 불가
# VALKEY_PASSWORD=
# DB_* 는 backend/.env 에서 직접 읽습니다. 다른 파일을 쓰려면 경로 지정 (선택, infra/ansible 기준 상대경로 또는 절대경로)
# BACKEND_ENV_FILE=../../backend/.env
